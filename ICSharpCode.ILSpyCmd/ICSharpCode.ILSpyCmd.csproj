<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <InvariantGlobalization>true</InvariantGlobalization>

    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyVersionAttribute>False</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>False</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>False</GenerateAssemblyInformationalVersionAttribute>
    <AssemblyName>ilspycmd</AssemblyName>
    <ToolCommandName>ilspycmd</ToolCommandName>
    <Description>Command-line decompiler using the ILSpy decompilation engine</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageVersion>8.0.0.0-noversion</PackageVersion>
    <Copyright>Copyright 2011-$([System.DateTime]::Now.Year) AlphaSierraPapa</Copyright>
    <PackageProjectUrl>https://github.com/icsharpcode/ILSpy/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>ILSpyCmdNuGetPackageIcon.png</PackageIcon>
    <RepositoryUrl>https://github.com/icsharpcode/ILSpy/</RepositoryUrl>
    <Company>ic#code</Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>ILSpy Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AsContainer\**" />
    <EmbeddedResource Remove="AsContainer\**" />
    <None Remove="AsContainer\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <!-- https://devblogs.microsoft.com/nuget/enable-repeatable-package-restores-using-a-lock-file/ -->
  <PropertyGroup>
	<RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!--
    RID-specific tool packaging (https://learn.microsoft.com/dotnet/core/tools/rid-specific-tools):
    a pointer package "ilspycmd" plus one package per RID. Opt-in via -p:IlspyCmdRidPackages=true so
    the default build keeps producing the classic framework-dependent package, unchanged and in the
    same time. Native AOT packages must be packed on a host with the same OS; CI runs:
      dotnet pack ICSharpCode.ILSpyCmd -c Release -p:IlspyCmdRidPackages=true                 (pointer)
      dotnet pack ICSharpCode.ILSpyCmd -c Release -p:IlspyCmdRidPackages=true -r any          (framework-dependent fallback)
      dotnet pack ICSharpCode.ILSpyCmd -c Release -p:IlspyCmdRidPackages=true -r win-x64      (Native AOT, Windows host)
      dotnet pack ICSharpCode.ILSpyCmd -c Release -p:IlspyCmdRidPackages=true -r linux-x64    (Native AOT, Linux host)
    Publish order on a feed: all RID packages first, the pointer package last.
    A pack with -r also restores the RID-agnostic ICSharpCode.Decompiler.Generators analyzer project with that
    RID and rewrites its packages.lock.json on disk; discard that change with git checkout.
  -->
  <PropertyGroup Condition="'$(IlspyCmdRidPackages)' == 'true'">
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;any</ToolPackageRuntimeIdentifiers>
    <!-- The pointer pack must not fan out into inner RID packs; each RID is packed explicitly with -r. -->
    <CreateRidSpecificToolPackages Condition="'$(RuntimeIdentifier)' == ''">false</CreateRidSpecificToolPackages>
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</PublishAot>
    <!-- Native symbols stay out of the AOT packages: on Windows the native PDB alone is over 100 MB. -->
    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(PublishAot)' == 'true'">false</CopyOutputSymbolsToPublishDirectory>
    <!-- The HTML diagrammer serializes its model with reflection-based System.Text.Json, which Native AOT turns
         off by default; ILSpyX is rooted below so the trimmer keeps the model's members for it. -->
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' == 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Pack goes through the regular Publish path instead of the build-time shortcut. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- PublishAot adds SDK-pinned ILCompiler/ILLink package references that the committed lock file does not
         list, so this graph gets its own throwaway lock file instead of a locked restore. -->
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)packages.ridtool.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
    <!-- Unannotated dependencies (NuGet.Protocol, Newtonsoft.Json, McMaster) produce trim and AOT analysis
         warnings; the repo-wide TreatWarningsAsErrors must not fail the AOT compile on them. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- McMaster binds [Option]/[Argument] properties by reflection over the command type; the BAML
         HandlerMap discovers IHandler implementations via Assembly.GetTypes(); the diagrammer in ILSpyX
         serializes its model (including anonymous types) by reflection. -->
    <TrimmerRootAssembly Include="ilspycmd" />
    <TrimmerRootAssembly Include="ICSharpCode.BamlDecompiler" />
    <TrimmerRootAssembly Include="ICSharpCode.ILSpyX" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>NU1605</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ILSpyCmdNuGetPackageIcon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ICSharpCode.ILSpyX\ICSharpCode.ILSpyX.csproj" />
    <ProjectReference Include="..\ICSharpCode.Decompiler\ICSharpCode.Decompiler.csproj" />
    <ProjectReference Include="..\ICSharpCode.BamlDecompiler\ICSharpCode.BamlDecompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <Target Name="ILSpyUpdateAssemblyInfo" AfterTargets="ResolveProjectReferences">
    <ReadLinesFromFile ContinueOnError="true" File="..\VERSION">
      <Output TaskParameter="Lines" PropertyName="PackageVersion" />
    </ReadLinesFromFile>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="ICSharpCode.ILSpyCmd.Tests" />
  </ItemGroup>

</Project>
