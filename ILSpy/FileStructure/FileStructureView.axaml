<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fs="using:ICSharpCode.ILSpy.FileStructure"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="ICSharpCode.ILSpy.FileStructure.FileStructureView"
             x:DataType="fs:FileStructureViewModel">
	<Panel>
		<TextBlock IsVisible="{Binding HasNoEntries}"
		           HorizontalAlignment="Center" VerticalAlignment="Center"
		           Margin="8" TextWrapping="Wrap" Opacity="0.7"
		           Text="The active document defines no types or members." />
		<ListBox Name="EntryList"
		         ItemsSource="{Binding Entries}"
		         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
		         SelectionMode="Single">
			<ListBox.ItemTemplate>
				<DataTemplate DataType="fs:FileMemberEntry">
					<StackPanel Orientation="Horizontal" Spacing="4" Margin="{Binding Indent}">
						<Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
						<TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Panel>
</UserControl>
