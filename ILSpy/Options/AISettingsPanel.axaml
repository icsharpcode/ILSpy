<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ICSharpCode.ILSpy.Options"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="ICSharpCode.ILSpy.Options.Panels.AISettingsPanel"
             x:DataType="vm:AISettingsViewModel">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="12" Spacing="10">
			<TextBlock FontWeight="Bold" FontSize="16" Text="AI Assistant" />
			<TextBlock TextWrapping="Wrap" Text="Configure an OpenAI-compatible provider. When an AI action runs, decompiled code and selected metadata are sent to that provider." />

			<Grid ColumnDefinitions="180,*" ColumnSpacing="12">
				<StackPanel Spacing="6">
					<TextBlock FontWeight="Bold" Text="Profiles" />
					<ListBox MinHeight="180" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" />
					<StackPanel Orientation="Horizontal" Spacing="4">
						<Button Content="Add" Command="{Binding AddProfileCommand}" />
						<Button Content="Duplicate" Command="{Binding DuplicateProfileCommand}" />
						<Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
						<Button Content="↑" Command="{Binding MoveProfileUpCommand}" />
						<Button Content="↓" Command="{Binding MoveProfileDownCommand}" />
					</StackPanel>
					<Button HorizontalAlignment="Left" Content="Use this profile" Command="{Binding ActivateProfileCommand}" />
				</StackPanel>
				<StackPanel Grid.Column="1" Spacing="10">
					<HeaderedContentControl Header="Profile name">
						<TextBox Text="{Binding DraftName, Mode=TwoWay}" />
					</HeaderedContentControl>
					<HeaderedContentControl Header="Provider">
						<StackPanel Spacing="3">
							<ComboBox ItemsSource="{Binding ProviderDescriptors}" SelectedItem="{Binding SelectedProviderDescriptor, Mode=TwoWay}">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Label}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Opacity="0.7" Text="{Binding ProviderKeyRequirement}" />
						</StackPanel>
					</HeaderedContentControl>
					<HeaderedContentControl Header="Endpoint">
						<TextBox Text="{Binding DraftBaseUrl, Mode=TwoWay}" PlaceholderText="https://api.openai.com" />
					</HeaderedContentControl>
					<HeaderedContentControl Header="Models">
						<StackPanel Spacing="4">
							<ListBox ItemsSource="{Binding AIProfileDraft.Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBox Width="180" Text="{Binding ModelNameInput, Mode=TwoWay}" PlaceholderText="Model name" />
								<Button Content="Add" Command="{Binding AddModelCommand}" />
								<Button Content="Rename" Command="{Binding RenameModelCommand}" />
								<Button Content="Delete" Command="{Binding DeleteModelCommand}" />
								<Button Content="↑" Command="{Binding MoveModelUpCommand}" />
								<Button Content="↓" Command="{Binding MoveModelDownCommand}" />
							</StackPanel>
						</StackPanel>
					</HeaderedContentControl>
			<HeaderedContentControl Header="Replacement API key">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
					<TextBox Grid.Column="0" PasswordChar="●" Text="{Binding ApiKeyInput, Mode=TwoWay}" PlaceholderText="Stored only after Save or Replace key" />
					<Button Grid.Column="1" Content="Replace key" Command="{Binding SaveKeyCommand}" />
					<Button Grid.Column="2" Content="Remove key" Command="{Binding ClearKeyCommand}" />
				</Grid>
			</HeaderedContentControl>
			<TextBlock Text="A stored or replacement key is configured." IsVisible="{Binding HasConfiguredKey}" />

			<HeaderedContentControl Header="Maximum context tokens">
				<NumericUpDown Minimum="4000" Maximum="128000" Increment="1000" Value="{Binding Settings.MaxContextTokens, Mode=TwoWay}" />
			</HeaderedContentControl>
			<CheckBox Content="Stream responses" IsChecked="{Binding Settings.StreamResponses, Mode=TwoWay}" />
			<CheckBox Content="Word wrap" IsChecked="{Binding Settings.WordWrap, Mode=TwoWay}" />
			<CheckBox Content="Include IL" IsChecked="{Binding Settings.SendIL, Mode=TwoWay}" />
			<CheckBox Content="Include call graph" IsChecked="{Binding Settings.SendCallGraph, Mode=TwoWay}" />

			<Border BorderBrush="Gray" BorderThickness="1" Padding="8">
				<CheckBox IsChecked="{Binding Settings.PrivacyConsentAccepted, Mode=TwoWay}"
				          Content="I understand that decompiled code and selected metadata will be sent to the configured AI provider." />
			</Border>
			<StackPanel Spacing="8">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="Test Connection" Command="{Binding TestConnectionCommand}" />
					<Button Content="Cancel Test" Command="{Binding CancelTestConnectionCommand}" IsVisible="{Binding IsTestingConnection}" />
					<Button Content="Save" Command="{Binding SaveCommand}" />
					<Button Content="Cancel" Command="{Binding CancelCommand}" />
				</StackPanel>
				<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
			</StackPanel>
				</StackPanel>
			</Grid>
		</StackPanel>
	</ScrollViewer>
</UserControl>
