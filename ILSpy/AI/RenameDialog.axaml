<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ICSharpCode.ILSpy.AI"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ICSharpCode.ILSpy.AI.RenameDialog"
        x:DataType="vm:RenameDialogViewModel"
        Title="Suggest Name with AI" Width="760" Height="560"
        WindowStartupLocation="CenterOwner">
	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
			<Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
			<Button Content="Apply" Click="ApplyClick" IsEnabled="{Binding CanApply}" IsVisible="{Binding !IsBusy}" />
			<Button Content="Close" Click="CloseClick" IsVisible="{Binding !IsBusy}" />
		</StackPanel>
		<StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,10">
			<TextBlock FontWeight="Bold" Text="{Binding TargetName}" />
			<TextBlock Text="Suggestions are generated from the selected symbol's decompiled code and metadata." TextWrapping="Wrap" />
			<TextBlock Text="{Binding StatusMessage}" />
			<TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
		</StackPanel>
		<Grid RowDefinitions="*,Auto" RowSpacing="8">
			<ListBox Grid.Row="0" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="6" Spacing="2">
							<TextBlock FontWeight="Bold" Text="{Binding Name}" />
							<TextBlock Text="{Binding ConfidencePercent, StringFormat='Confidence: {0}%'}" />
							<TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<TextBox Grid.Row="1" Text="{Binding RawResponse}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" IsVisible="{Binding HasRawResponse}" />
		</Grid>
	</DockPanel>
</Window>
