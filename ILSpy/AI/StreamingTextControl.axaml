<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ICSharpCode.ILSpy.AI"
             x:Class="ICSharpCode.ILSpy.AI.StreamingTextControl">
	<TextBox Text="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type local:StreamingTextControl}}}"
	         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
</UserControl>
