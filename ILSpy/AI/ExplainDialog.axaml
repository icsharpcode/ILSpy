<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ICSharpCode.ILSpy.AI"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ICSharpCode.ILSpy.AI.ExplainDialog"
        x:DataType="vm:ExplainDialogViewModel"
        Title="Explain with AI" Width="760" Height="560"
        WindowStartupLocation="CenterOwner">
	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
			<Button Content="Copy to Clipboard" Click="CopyClick" IsEnabled="{Binding CanCopy}" />
			<Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
			<Button Content="Close" Click="CloseClick" IsVisible="{Binding !IsBusy}" />
		</StackPanel>
		<StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,10">
			<TextBlock FontWeight="Bold" Text="{Binding TargetName}" />
			<TextBlock Text="This request sends decompiled code and selected metadata to the configured AI provider." TextWrapping="Wrap" />
			<TextBlock Text="{Binding StatusMessage}" />
			<TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
		</StackPanel>
		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
			<TextBox Text="{Binding Response}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
		</ScrollViewer>
	</DockPanel>
</Window>
