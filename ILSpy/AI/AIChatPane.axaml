<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ICSharpCode.ILSpy.AI" xmlns:controls="using:ICSharpCode.ILSpy.AI.Controls" x:Class="ICSharpCode.ILSpy.AI.AIChatPane" x:DataType="vm:AIChatPaneModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
      <TextBox Text="{Binding Input}" AcceptsReturn="True" MinHeight="54" PlaceholderText="Ask about the decompiled code…" />
      <ItemsControl ItemsSource="{Binding CommandSuggestions}" IsVisible="{Binding ShowSuggestions}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
        <Button Content="Export" Command="{Binding ExportCommand}" />
      </StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Profile" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" SelectionChanged="OnProfileChanged" Width="180" />
        <TextBlock Text="Model" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding ActiveProfile.LastSelectedModel}" SelectionChanged="OnModelChanged" Width="160" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding ReadinessMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
        <Button Content="Open AI Settings" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding !IsReady}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding StatusMessage}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed"/></StackPanel>
    </StackPanel>
    <ListBox x:Name="ConversationList" ItemsSource="{Binding Messages}" Background="Transparent" Padding="0" Margin="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <controls:ChatMessageControl />
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,6" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </DockPanel>
</UserControl>
